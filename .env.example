# SMSVIO local environment.
#
#   cp .env.example .env
#
# Every value below is a working default for local development only. Never reuse these
# passwords anywhere else. Production values live in /opt/smsvio/.env on the server and are
# generated by the steps in docs/DEPLOY.md.
#
# The same file serves two purposes:
#   - `docker compose up` reads it to configure the local container stack.
#   - `pnpm dev` (api, worker) and Prisma commands read it when running on your machine.

# ── Runtime ──────────────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Release identifier attached to logs and error reports. CI sets the git commit SHA.
APP_RELEASE=local

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────
POSTGRES_DB=smsvio
POSTGRES_USER=smsvio
POSTGRES_PASSWORD=smsvio_local_only
# Host port the local Postgres container is published on (bound to 127.0.0.1).
POSTGRES_PORT=5432
# Connection string used by the api and Prisma when running on your machine. Inside Docker
# Compose the hostname is rewritten to `postgres` automatically.
DATABASE_URL=postgresql://smsvio:smsvio_local_only@localhost:5432/smsvio
# Maximum connections in the api's database pool (1-100).
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=smsvio_local_only
# Host port the local Redis container is published on (bound to 127.0.0.1).
REDIS_PORT=6379
# Connection string used by the api and worker when running on your machine.
REDIS_URL=redis://:smsvio_local_only@localhost:6379/0

# ── API ──────────────────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
# Reverse-proxy hops in front of the api whose X-Forwarded-For header is trusted.
# 0 when you call the api directly; Docker Compose and production set 1 (Caddy).
TRUST_PROXY_HOPS=0
# How long /readyz waits for each dependency before reporting it down (100-30000 ms).
READINESS_TIMEOUT_MS=2000
# Browser origin for `pnpm dev` (web on port 3000). Docker Compose overrides this for the api
# container so it matches http://localhost:$HTTP_PORT.
PUBLIC_ORIGIN=http://localhost:3000
# Local-only AES-256-GCM key. Generate a new one for production; never reuse this value.
APP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Local Mailpit. The compose stack points the api at the mailpit service.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SMSVIO <noreply@smsvio.test>
# Demo account created by the migrate container. Production refuses this password.
SEED_ADMIN_EMAIL=admin@smsvio.test
SEED_ADMIN_PASSWORD=smsvio-demo-local
SEED_ADMIN_NAME=SMSVIO Admin
SEED_ORG_NAME=SMSVIO Demo

# ── Worker ───────────────────────────────────────────────────────────────────────────────
# How often the worker publishes its Redis heartbeat (1000-60000 ms).
WORKER_HEARTBEAT_INTERVAL_MS=10000

# ── Local reverse proxy ──────────────────────────────────────────────────────────────────
# `docker compose up` serves the whole stack on http://localhost:${HTTP_PORT}.
HTTP_PORT=8080

# ── Error reporting (optional) ───────────────────────────────────────────────────────────
# Leave SENTRY_DSN empty to keep Sentry disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
