// SMSVIO database schema. Models are added phase by phase (see docs/SPEC.md section 8).
// The datasource URL lives in prisma.config.ts.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}
