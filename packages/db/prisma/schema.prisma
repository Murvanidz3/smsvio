// SMSVIO database schema. Models are added phase by phase (see docs/SPEC.md section 8).
// The datasource URL lives in prisma.config.ts.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  DEVELOPER
  BILLING
  VIEWER
}

enum MembershipStatus {
  ACTIVE
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique @db.Citext
  passwordHash           String?
  googleSub              String?   @unique
  name                   String
  emailVerifiedAt        DateTime?
  totpSecretEnc          String?
  totpPendingSecretEnc   String?
  totpEnabledAt          DateTime?
  totpLastStep           Int?
  isPlatformAdmin        Boolean   @default(false)
  lastSeenAt             DateTime?
  accountPhoneE164       String?
  accountPhoneVerifiedAt DateTime?
  contactPhone           String?
  timezone               String    @default("UTC")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions     Session[]
  memberships  Membership[]
  invitations  Invitation[] @relation("InvitedBy")
  authTokens   AuthToken[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  templates    Template[]
  messages     Message[]
  apiKeys      ApiKey[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?
  status               OrganizationStatus @default(PENDING_VERIFICATION)
  timezone             String             @default("UTC")
  smartEncoding        Boolean            @default(true)
  dailySpendCapMicros  BigInt?
  messageRetentionDays Int                @default(365)
  taxIdType            String?
  taxId                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  contacts     Contact[]
  templates    Template[]
  messages     Message[]
  senderIds    SenderId[]
  orgCountries OrgCountry[]
  orgRates     OrgRate[]
  balance      OrgBalance?
  ledgerEntries LedgerEntry[]
  apiKeys      ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  billingProfile BillingProfile?
  dailyUsage   DailyUsage[]
  complianceProfile ComplianceProfile?
  useCases     UseCase[]
  complianceDocuments ComplianceDocument[]
  autoReplies  AutoReply[]
  optOuts      OptOut[]

  @@index([status])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String         @db.Citext
  role           MembershipRole
  tokenHash      String         @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User           @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("invitations")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  subject   String?
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  targetType     String
  targetId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum TemplateCategory {
  AUTHENTICATION
  UTILITY
  MARKETING
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  UNDELIVERED
  EXPIRED
  FAILED
  REJECTED
}

model Country {
  iso2                 String   @id @db.Char(2)
  name                 String
  dialCode             String
  alphaSenderAllowed   Boolean
  registrationRequired Boolean
  notes                String?
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  networks             Network[]
  routes               Route[]
  rates                Rate[]
  orgCountries         OrgCountry[]

  @@map("countries")
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  phoneE164      String
  countryCode    String       @db.Char(2)
  name           String?
  attributes     Json         @default("{}")
  optedOut       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneE164])
  @@index([organizationId, createdAt])
  @@map("contacts")
}

model Template {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  name            String
  category        TemplateCategory
  language        String
  body            String
  variables       Json             @default("{}")
  status          TemplateStatus   @default(DRAFT)
  rejectionReason String?
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages        Message[]

  @@index([organizationId, createdAt])
  @@map("templates")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  direction         MessageDirection
  to                String
  fromSender        String           @map("from")
  body              String
  templateId        String?          @db.Uuid
  templateVars      Json?
  encoding          String
  segments          Int
  countryIso2       String?          @db.Char(2)
  mccmnc            String?
  status            MessageStatus
  errorCode         String?
  providerId        String?          @db.Uuid
  providerMessageId String?
  routeId           String?          @db.Uuid
  priceMicros       BigInt?
  costMicros        BigInt?
  clientRef         String?
  apiKeyId          String?          @db.Uuid
  /// Test API keys store the quoted price and leave this false so nothing is charged.
  billable          Boolean          @default(true)
  userId            String?          @db.Uuid
  scheduledAt       DateTime?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  attempt           Int              @default(0)
  failedRouteIds    String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template          Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  route             Route?           @relation(fields: [routeId], references: [id], onDelete: SetNull)
  apiKey            ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  events            MessageEvent[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, to])
  @@index([status, sentAt])
  @@index([status, queuedAt])
  @@index([status, updatedAt])
  @@index([providerMessageId])
  @@unique([providerId, providerMessageId])
  @@unique([organizationId, clientRef])
  @@map("messages")
}

model MessageEvent {
  id          String        @id @default(uuid()) @db.Uuid
  messageId   String        @db.Uuid
  status      MessageStatus
  detail      String?
  providerRaw Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  message     Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_events")
}

enum ProviderType {
  MOCK
  SMPP
  HTTP
}

enum ProviderStatus {
  ACTIVE
  DISABLED
}

enum SenderType {
  ALPHANUMERIC
  LONG_CODE
  SHORT_CODE
}

enum SenderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerType {
  TOPUP
  HOLD
  CHARGE
  RELEASE
  REFUND
  ADJUSTMENT
}

/// MCC/MNC reference names. A route may name a network before a row exists here.
model Network {
  mcc         String
  mnc         String
  countryIso2 String   @db.Char(2)
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     Country  @relation(fields: [countryIso2], references: [iso2], onDelete: Cascade)

  @@id([mcc, mnc])
  @@index([countryIso2])
  @@map("networks")
}

model Provider {
  id                 String         @id @default(uuid()) @db.Uuid
  code               String         @unique
  type               ProviderType
  configEnc          String?
  status             ProviderStatus @default(ACTIVE)
  maxTps             Int
  callbackSecretHash String?
  /// Required customer markup over this provider's route cost. 50 means cost + 50%.
  markupPercent      Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  routes             Route[]
  messages           Message[]

  @@map("providers")
}

model Route {
  id            String    @id @default(uuid()) @db.Uuid
  countryIso2   String    @db.Char(2)
  /// Null is the country-wide route. A value is an MCC+MNC override.
  mccmnc        String?
  providerId    String    @db.Uuid
  /// Lower numbers are chosen first.
  priority      Int
  weight        Int
  costMicros    BigInt
  /// When set, replaces the provider markup for this destination only.
  markupPercent Int?
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  country       Country   @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  messages      Message[]

  @@index([countryIso2, enabled, priority])
  @@map("routes")
}

/// A manual fixed customer price. The latest effectiveFrom at or before now wins.
model Rate {
  id            String   @id @default(uuid()) @db.Uuid
  countryIso2   String   @db.Char(2)
  mccmnc        String?
  priceMicros   BigInt
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  country       Country  @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)

  @@index([countryIso2, mccmnc, effectiveFrom])
  @@map("rates")
}

model OrgRate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  countryIso2    String       @db.Char(2)
  mccmnc         String?
  priceMicros    BigInt
  effectiveFrom  DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, countryIso2, mccmnc, effectiveFrom])
  @@map("org_rates")
}

model SenderId {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  type              SenderType
  value             String
  status            SenderStatus @default(PENDING)
  useCase           String
  reviewNote        String?
  intendedCountries String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgCountries      OrgCountry[]

  @@unique([organizationId, value])
  @@index([organizationId, createdAt])
  @@map("sender_ids")
}

model OrgCountry {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  countryIso2          String       @db.Char(2)
  senderIdId           String?      @db.Uuid
  registrationComplete Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country              Country      @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)
  sender               SenderId?    @relation(fields: [senderIdId], references: [id], onDelete: Restrict)

  @@unique([organizationId, countryIso2])
  @@index([organizationId])
  @@map("org_countries")
}

model OrgBalance {
  organizationId  String       @id @db.Uuid
  availableMicros BigInt       @default(0)
  heldMicros      BigInt       @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_balances")
}

/// Append-only. amountMicros is the available-balance delta, except CHARGE, which records the price and does not move available.
model LedgerEntry {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  type               LedgerType
  amountMicros       BigInt
  balanceAfterMicros BigInt
  refType            String?
  refId              String?
  note               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, refId])
  @@map("ledger_entries")
}

/// Billing contact, low-balance mail, and auto-recharge settings. Charging a saved card waits for a payment provider.
model BillingProfile {
  organizationId              String       @id @db.Uuid
  email                       String?
  name                        String?
  line1                       String?
  line2                       String?
  city                        String?
  region                      String?
  postalCode                  String?
  countryIso2                 String?      @db.Char(2)
  lowBalanceMicros            BigInt?
  lowBalanceNotifiedAt        DateTime?
  autoRechargeEnabled         Boolean      @default(false)
  autoRechargeThresholdMicros BigInt?
  autoRechargeAmountMicros    BigInt?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

/// One row per organization per UTC day. The worker rewrites the open window every 15 minutes.
model DailyUsage {
  organizationId String       @db.Uuid
  day            String       @db.Char(10)
  sent           Int
  delivered      Int
  failed         Int
  finalCount     Int
  spendMicros    BigInt
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, day])
  @@index([organizationId, day])
  @@map("daily_usage")
}

/// Single row id `platform`. Organizations with a null spend cap inherit this value.
/// sharedSender is null until the seed applies the default, and empty when an operator hides it.
model PlatformSetting {
  id                         String   @id
  defaultDailySpendCapMicros BigInt
  sharedSender               String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("platform_settings")
}

enum ApiKeyMode {
  LIVE
  TEST
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// The full key is shown once. Only its SHA-256 hash, a short prefix, and the last four characters are stored.
model ApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  mode           ApiKeyMode
  prefix         String
  keyHash        String       @unique
  last4          String
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages       Message[]

  @@index([organizationId, createdAt])
  @@map("api_keys")
}

/// secretEnc is AES-256-GCM. The plaintext is a Standard Webhooks secret (whsec_…).
model WebhookEndpoint {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  name                String
  url                 String
  secretEnc           String
  events              String[]
  status              WebhookEndpointStatus @default(ACTIVE)
  consecutiveFailures Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries          WebhookDelivery[]

  @@index([organizationId, createdAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  endpointId     String                @db.Uuid
  eventId        String
  eventType      String
  payload        Json
  attempt        Int                   @default(0)
  responseStatus Int?
  responseMs     Int?
  nextRetryAt    DateTime?
  status         WebhookDeliveryStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

/// Submitted business verification. A row means the form is locked until an operator decides.
model ComplianceProfile {
  organizationId       String       @id @db.Uuid
  legalName            String
  address              String
  website              String?
  registrationNumber   String?
  registrationCountry  String       @db.Char(2)
  submittedAt          DateTime     @default(now())
  reviewNote           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("compliance_profiles")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model UseCase {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  purpose        String
  sample         String
  optIn          String
  status         ReviewStatus @default(PENDING)
  reviewNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("use_cases")
}

/// Private file. The bytes are AES-256-GCM ciphertext, not a public URL.
model ComplianceDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  countryIso2    String       @db.Char(2)
  kind           String
  filename       String
  contentType    String
  bytesEnc       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("compliance_documents")
}

enum AutoReplyCategory {
  HELP
  OPT_IN
  OPT_OUT
  CUSTOM
}

model AutoReply {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  category       AutoReplyCategory
  keywords       String[]
  body           String
  protected      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("auto_replies")
}

/// Survives contact deletion. A send to this number is recipient_opted_out.
model OptOut {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  phoneE164      String
  source         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneE164])
  @@index([organizationId])
  @@map("opt_outs")
}
