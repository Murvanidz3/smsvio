    "@smsvio/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@smsvio/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
