{
  "name": "@smsvio/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./phone": {
      "types": "./dist/sms/phone-api.d.ts",
      "default": "./dist/sms/phone-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smsvio/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
