{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version", "packages/config/**"],
  "globalPassThroughEnv": ["CHECKPOINT_DISABLE", "PRISMA_HIDE_UPDATE_MESSAGE", "CI"],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "PUBLIC_ORIGIN",
        "APP_ENCRYPTION_KEY",
        "EMAIL_MODE",
        "SMTP_HOST",
        "SMTP_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SEED_ADMIN_EMAIL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build", "@smsvio/api#build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "E2E_BASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "SEED_ADMIN_NAME",
        "SEED_ORG_NAME",
        "APP_ENCRYPTION_KEY",
        "SMTP_FROM"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    }
  }
}
