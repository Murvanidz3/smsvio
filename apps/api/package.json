{
  "name": "@smsvio/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrument.js dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@sentry/nestjs": "11.11.0",
    "@smsvio/db": "workspace:*",
    "@smsvio/server": "workspace:*",
    "@smsvio/shared": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.4.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@smsvio/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "supertest": "^7.3.2",
    "tsc-watch": "^7.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
